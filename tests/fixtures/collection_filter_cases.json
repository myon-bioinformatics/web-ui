      "name": "combined-tag-and-status",
      "request": {
        "items": [
          {
            "name": "Aoi",
            "topics": [
              "python",
              "research"
            ],
            "archived": false
          },
          {
            "name": "Legacy",
            "topics": [
              "python"
            ],
            "archived": true
          },
          {
            "name": "Ironmate",
            "topics": [
              "javascript"
            ],
            "archived": false
          }
        ],
        "query": " PYTHON ",
        "text_fields": [
          "name",
          "topics"
        ],
        "facets": {
          "archived": false,
          "topics": "python"
        }
      },
      "expected": [
        {
          "name": "Aoi",
          "topics": [
            "python",
            "research"
          ],
          "archived": false
        }
      ]
    },
