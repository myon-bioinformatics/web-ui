{
  "schema": "web-ui-layout-presets/1",
  "default": "grid8",
  "presets": [
    {"id": "grid8", "label": "8px grid", "note": "default: 160px tiles, 8px spacing",
     "vars": {"--ui-matrix-col": "160px", "--ui-matrix-gap": "8px", "--ui-matrix-pad": "8px"}},
    {"id": "compact", "label": "Compact", "note": "more tiles per row on small screens",
     "vars": {"--ui-matrix-col": "120px", "--ui-matrix-gap": "4px", "--ui-matrix-pad": "4px"}},
    {"id": "device", "label": "Device width", "note": "195px = half an iPhone (390px)",
     "vars": {"--ui-matrix-col": "195px", "--ui-matrix-gap": "6px", "--ui-matrix-pad": "6px"}},
    {"id": "wide", "label": "Wide", "note": "larger tiles for detail",
     "vars": {"--ui-matrix-col": "240px", "--ui-matrix-gap": "16px", "--ui-matrix-pad": "8px"}}
  ]
}
